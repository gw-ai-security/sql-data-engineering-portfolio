        <mxCell id="bronzeHeader" value="Bronze Layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="180" width="310" height="65" as="geometry"/></mxCell>
        <mxCell id="bronzeDb" value="RAW&lt;br&gt;TABLES" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=18;fillColor=#FCE8D5;strokeColor=#D79B00;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="555" y="285" width="180" height="125" as="geometry"/></mxCell>
        <mxCell id="bronzeText" value="&lt;b&gt;Purpose&lt;/b&gt;&lt;br&gt;Preserve source data as-is for traceability and debugging&lt;br&gt;&lt;br&gt;&lt;b&gt;Object Type&lt;/b&gt;&lt;br&gt;Tables&lt;br&gt;&lt;br&gt;&lt;b&gt;Load&lt;/b&gt;&lt;br&gt;• Batch processing&lt;br&gt;• Full load&lt;br&gt;• TRUNCATE + BULK INSERT&lt;br&gt;&lt;br&gt;&lt;b&gt;Transformations&lt;/b&gt;&lt;br&gt;None&lt;br&gt;&lt;br&gt;&lt;b&gt;Data Model&lt;/b&gt;&lt;br&gt;Source-aligned (as-is)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="445" width="300" height="350" as="geometry"/></mxCell>
        <mxCell id="silverHeader" value="Silver Layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="885" y="180" width="310" height="65" as="geometry"/></mxCell>
        <mxCell id="silverDb" value="CLEAN&lt;br&gt;TABLES" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=18;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="980" y="285" width="180" height="125" as="geometry"/></mxCell>
        <mxCell id="silverText" value="&lt;b&gt;Purpose&lt;/b&gt;&lt;br&gt;Clean and standardize data before analytics&lt;br&gt;&lt;br&gt;&lt;b&gt;Object Type&lt;/b&gt;&lt;br&gt;Tables&lt;br&gt;&lt;br&gt;&lt;b&gt;Load&lt;/b&gt;&lt;br&gt;• Batch processing&lt;br&gt;• Full load&lt;br&gt;• TRUNCATE + INSERT&lt;br&gt;&lt;br&gt;&lt;b&gt;Transformations&lt;/b&gt;&lt;br&gt;• Data cleansing&lt;br&gt;• Standardization&lt;br&gt;• Normalization&lt;br&gt;• Derived columns&lt;br&gt;• Enrichment&lt;br&gt;&lt;br&gt;&lt;b&gt;Data Model&lt;/b&gt;&lt;br&gt;Source-aligned; no business model yet" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;" vertex="1" parent="1"><mxGeometry x="895" y="445" width="300" height="370" as="geometry"/></mxCell>
        <mxCell id="goldHeader" value="Gold Layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1315" y="180" width="320" height="65" as="geometry"/></mxCell>
        <mxCell id="goldDb" value="BUSINESS&lt;br&gt;VIEWS" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=18;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1385" y="285" width="180" height="125" as="geometry"/></mxCell>
        <mxCell id="goldText" value="&lt;b&gt;Purpose&lt;/b&gt;&lt;br&gt;Business-ready analytical data product&lt;br&gt;&lt;br&gt;&lt;b&gt;Object Type&lt;/b&gt;&lt;br&gt;Views&lt;br&gt;&lt;br&gt;&lt;b&gt;Load&lt;/b&gt;&lt;br&gt;No physical load&lt;br&gt;&lt;br&gt;&lt;b&gt;Transformations&lt;/b&gt;&lt;br&gt;• CRM / ERP integration&lt;br&gt;• Source precedence&lt;br&gt;• Dimensional modeling&lt;br&gt;&lt;br&gt;&lt;b&gt;Data Model&lt;/b&gt;&lt;br&gt;• dim_customers&lt;br&gt;• dim_products&lt;br&gt;• fact_sales&lt;br&gt;&lt;br&gt;&lt;b&gt;Historization&lt;/b&gt;&lt;br&gt;Latest snapshot only" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1320" y="445" width="320" height="370" as="geometry"/></mxCell>
        <mxCell id="bi" value="BI &amp;amp; Reporting&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Power BI / Tableau&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1825" y="285" width="230" height="100" as="geometry"/></mxCell>
        <mxCell id="adhoc" value="Ad-hoc SQL&lt;br&gt;Queries" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1825" y="440" width="230" height="100" as="geometry"/></mxCell>
        <mxCell id="ml" value="Machine Learning&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;downstream consumer&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1825" y="595" width="230" height="100" as="geometry"/></mxCell>
        <mxCell id="consumerNote" value="&lt;b&gt;Primary contract:&lt;/b&gt;&lt;br&gt;Consumers read from the Gold layer — not directly from raw sources." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1810" y="745" width="260" height="90" as="geometry"/></mxCell>
