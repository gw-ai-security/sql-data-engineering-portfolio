        <mxCell id="subtitle" value="CRM + ERP CSV sources → Bronze → Silver → Gold → Analytics consumers" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="42" y="82" width="900" height="30" as="geometry"/></mxCell>
