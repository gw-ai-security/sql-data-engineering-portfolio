        <mxCell id="silverBg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#A6A6A6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="855" y="215" width="370" height="650" as="geometry"/></mxCell>
