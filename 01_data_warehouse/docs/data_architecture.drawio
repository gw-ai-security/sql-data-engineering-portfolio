        <mxCell id="crm" value="CRM&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;CSV files&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="95" y="290" width="190" height="100" as="geometry"/></mxCell>
        <mxCell id="erp" value="ERP&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;CSV files&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="95" y="430" width="190" height="100" as="geometry"/></mxCell>
        <mxCell id="sourceMeta" value="&lt;b&gt;Object Type:&lt;/b&gt; CSV Files&lt;br&gt;&lt;b&gt;Interface:&lt;/b&gt; Files in Folders&lt;br&gt;&lt;br&gt;&lt;b&gt;Scope:&lt;/b&gt; latest dataset only" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;" vertex="1" parent="1"><mxGeometry x="80" y="590" width="220" height="150" as="geometry"/></mxCell>
