        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5B9BD5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" parent="1" source="goldDb" target="ml"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1695" y="350"/><mxPoint x="1695" y="645"/></Array></mxGeometry></mxCell>
        <mxCell id="footer" value="&lt;b&gt;Architecture principles:&lt;/b&gt; Separation of concerns • Raw preservation • Data quality before analytics • Business logic in Gold • Consumer-friendly analytical model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#B3B3B3;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="390" y="955" width="1320" height="70" as="geometry"/></mxCell>
