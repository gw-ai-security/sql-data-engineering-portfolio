  <diagram id="end-to-end-lineage" name="Bronze Silver Gold Data Flow">
    <mxGraphModel dx="2200" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="SQL Data Warehouse — End-to-End Data Flow" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1000" height="50" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="CRM / ERP CSVs → Bronze raw tables → Silver trusted source-aligned tables → Gold star schema views → analytical consumers" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="42" y="80" width="1300" height="30" as="geometry"/></mxCell>

        <mxCell id="sources" value="&lt;b&gt;1. Sources&lt;/b&gt;&lt;br&gt;CRM — 3 CSV files&lt;br&gt;ERP — 3 CSV files&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;latest snapshot&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=16;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="310" height="150" as="geometry"/></mxCell>
        <mxCell id="bronze" value="&lt;b&gt;2. Bronze&lt;/b&gt;&lt;br&gt;6 source-aligned tables&lt;br&gt;TRUNCATE + BULK INSERT&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;raw preservation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8D5;strokeColor=#D79B00;strokeWidth=2;fontSize=16;" vertex="1" parent="1"><mxGeometry x="470" y="150" width="330" height="150" as="geometry"/></mxCell>
        <mxCell id="silver" value="&lt;b&gt;3. Silver&lt;/b&gt;&lt;br&gt;6 cleaned source-aligned tables&lt;br&gt;TRUNCATE + INSERT&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;clean • standardize • align keys&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;fontSize=16;" vertex="1" parent="1"><mxGeometry x="900" y="150" width="360" height="150" as="geometry"/></mxCell>
        <mxCell id="gold" value="&lt;b&gt;4. Gold&lt;/b&gt;&lt;br&gt;dim_customers • dim_products&lt;br&gt;fact_sales&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;views • integrate • model&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBE6;strokeColor=#D8C45A;strokeWidth=2;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1360" y="150" width="360" height="150" as="geometry"/></mxCell>
        <mxCell id="consumers" value="&lt;b&gt;5. Consume&lt;/b&gt;&lt;br&gt;BI / Reporting&lt;br&gt;Ad-hoc SQL&lt;br&gt;Analytical workloads" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1820" y="150" width="320" height="150" as="geometry"/></mxCell>

        <mxCell id="pipeline1" value="batch full load" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#5B9BD5;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sources" target="bronze"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pipeline2" value="clean + standardize" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#7F8C8D;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="bronze" target="silver"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pipeline3" value="integrate + model" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#9673A6;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="silver" target="gold"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pipeline4" value="serve" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#82B366;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="gold" target="consumers"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="lineageHeader" value="Silver-to-Gold lineage" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="380" width="500" height="40" as="geometry"/></mxCell>

        <mxCell id="salesSilver" value="&lt;b&gt;silver.crm_sales_details&lt;/b&gt;&lt;br&gt;orders • dates • measures&lt;br&gt;sls_prd_key • sls_cust_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;align=left;spacingLeft=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="100" y="480" width="420" height="130" as="geometry"/></mxCell>
        <mxCell id="customerSilver" value="&lt;b&gt;silver.crm_cust_info&lt;/b&gt;&lt;br&gt;&lt;b&gt;silver.erp_cust_az12&lt;/b&gt;&lt;br&gt;&lt;b&gt;silver.erp_loc_a101&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;customer master + demographics + location&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;align=left;spacingLeft=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="100" y="690" width="420" height="180" as="geometry"/></mxCell>
        <mxCell id="productSilver" value="&lt;b&gt;silver.crm_prd_info&lt;/b&gt;&lt;br&gt;&lt;b&gt;silver.erp_px_cat_g1v2&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;current product + category reference&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;align=left;spacingLeft=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="100" y="960" width="420" height="150" as="geometry"/></mxCell>

        <mxCell id="factGold" value="&lt;b&gt;gold.fact_sales&lt;/b&gt;&lt;br&gt;60,398 sales lines&lt;br&gt;customer_key • product_key&lt;br&gt;dates • sales_amount • quantity • price" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=3;align=left;spacingLeft=16;fontSize=16;" vertex="1" parent="1"><mxGeometry x="890" y="470" width="430" height="150" as="geometry"/></mxCell>
        <mxCell id="customerGold" value="&lt;b&gt;gold.dim_customers&lt;/b&gt;&lt;br&gt;18,484 customers&lt;br&gt;CRM anchor • ERP enrichment&lt;br&gt;CRM gender precedence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;align=left;spacingLeft=16;fontSize=16;" vertex="1" parent="1"><mxGeometry x="890" y="700" width="430" height="150" as="geometry"/></mxCell>
        <mxCell id="productGold" value="&lt;b&gt;gold.dim_products&lt;/b&gt;&lt;br&gt;295 current products&lt;br&gt;product master • category enrichment&lt;br&gt;prd_end_dt IS NULL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;align=left;spacingLeft=16;fontSize=16;" vertex="1" parent="1"><mxGeometry x="890" y="960" width="430" height="150" as="geometry"/></mxCell>

        <mxCell id="salesLineage" value="preserve sales-line grain" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#9673A6;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="salesSilver" target="factGold"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="customerLineage" value="integrate CUSTOMER" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#6C8EBF;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="customerSilver" target="customerGold"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="productLineage" value="integrate PRODUCT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#82B366;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="productSilver" target="productGold"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="customerToFact" value="customer_key" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6C8EBF;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="customerGold" target="factGold"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1510" y="775"/><mxPoint x="1510" y="545"/></Array></mxGeometry></mxCell>
        <mxCell id="productToFact" value="product_key" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#82B366;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="productGold" target="factGold"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1600" y="1035"/><mxPoint x="1600" y="545"/></Array></mxGeometry></mxCell>

        <mxCell id="boundary" value="&lt;b&gt;Layer boundary:&lt;/b&gt; Bronze preserves source data • Silver makes it technically trustworthy • Gold integrates business objects and exposes the analytical consumer contract." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#B3B3B3;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="450" y="1170" width="1300" height="80" as="geometry"/></mxCell>
