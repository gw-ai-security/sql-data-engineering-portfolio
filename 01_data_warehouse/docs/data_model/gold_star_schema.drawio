        <mxCell id="note" value="&lt;b&gt;Logical model:&lt;/b&gt; the views do not declare physical PK/FK constraints. Runtime quality checks validate dimension grain, fact connectivity, row preservation and join cardinality." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#B3B3B3;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="260" y="880" width="1280" height="80" as="geometry"/></mxCell>
